<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Your account"/>
<%@ include file="../fragments/head.jspf" %><%@ include file="../fragments/header.jspf" %>
<main id="main" class="container app-main account-page">
 <div class="page-heading"><div><span class="eyebrow">${ui['ACCOUNT']}</span><h1>${ui['Your account']}</h1><p>${ui['Personal details, your home area and the way CivicPulse looks.']}</p></div></div>
 <c:if test="${param.saved != null}"><div class="notice notice-success" role="status">${ui['Your changes have been saved.']}</div></c:if>
 <div class="account-layout"><aside class="surface account-identity"><div class="profile-avatar" aria-hidden="true"><c:out value="${displayName.substring(0,1)}"/></div><h2><c:out value="${displayName}"/></h2><span class="role-chip">${ui[roleLabel]}</span><dl class="detail-facts"><dt>${ui['Email address']}</dt><dd><c:out value="${accountEmail}"/></dd><dt>${ui['Member since']}</dt><dd><time datetime="${memberSince}"><c:out value="${memberSince}"/></time></dd></dl><p class="field-help">${ui['Your contact details and date of birth are private. They are never shown in the community feed.']}</p></aside>
 <form:form method="post" action="${pageContext.request.contextPath}/account" modelAttribute="profileForm" cssClass="civic-form account-form">
 <c:if test="${not empty requestScope['org.springframework.validation.BindingResult.profileForm'].allErrors}"><div class="notice notice-error" role="alert"><c:forEach items="${requestScope['org.springframework.validation.BindingResult.profileForm'].allErrors}" var="error"><p><c:out value="${ui[error.defaultMessage]}"/></p></c:forEach></div></c:if>
 <section class="surface"><h2>${ui['Personal information']}</h2><p class="muted">${ui['Additional details are optional. You can add them whenever you like.']}</p><div class="two-columns">
 <div><label for="displayName">${ui['Display name']}</label><form:input path="displayName" id="displayName" required="required" maxlength="80" autocomplete="name"/></div>
 <div><label for="dateOfBirth">${ui['Date of birth']}</label><form:input path="dateOfBirth" id="dateOfBirth" type="date" autocomplete="bday"/></div>
 <div><label for="phone">${ui['Phone number']}</label><form:input path="phone" id="phone" type="tel" maxlength="24" autocomplete="tel"/></div>
 <div><label for="neighbourhood">${ui['Neighbourhood / ward']}</label><form:input path="neighbourhood" id="neighbourhood" maxlength="100"/></div></div></section>
 <section class="surface" data-address-widget data-lat-input="homeLatitude" data-lon-input="homeLongitude"><h2>${ui['Home area']}</h2><p class="muted">${ui['Choose your home area to personalise nearby reports.']}</p>
 <label for="address">${ui['Address or landmark']}</label><div class="address-search"><form:input path="address" id="address" maxlength="250" autocomplete="off" aria-autocomplete="list" aria-controls="address-suggestions" aria-expanded="false" data-address="true"/><div id="address-suggestions" class="address-suggestions" role="listbox" hidden></div></div>
 <form:hidden path="homeLatitude" id="homeLatitude"/><form:hidden path="homeLongitude" id="homeLongitude"/>
 <div class="two-columns"><div><label for="city">${ui['City']}</label><form:input path="city" id="city" maxlength="80" autocomplete="address-level2"/></div><div><label for="postalCode">${ui['Postal code']}</label><form:input path="postalCode" id="postalCode" maxlength="16" autocomplete="postal-code"/></div></div>
 <div class="location-actions"><button type="button" class="button button-small button-outline" data-locate>${ui['Use my location']}</button><button type="button" class="button button-small button-outline" data-clear-location>${ui['Clear home area']}</button></div><p class="field-help" data-map-message role="status">${ui['Search an address or select a place on the map.']}</p><div class="location-map" data-location-picker aria-label="${ui['Choose home area']}"></div><p class="field-help">${ui['Address search uses OpenStreetMap data via Photon.']}</p></section>
 <section class="surface"><h2>${ui['Display preferences']}</h2><div class="two-columns"><div><label for="theme">${ui['Theme']}</label><form:select path="theme" id="theme"><form:option value="system">${ui['Use device setting']}</form:option><form:option value="light">${ui['Light']}</form:option><form:option value="dark">${ui['Dark']}</form:option></form:select></div><div><label for="language">${ui['Language']}</label><form:select path="language" id="language"><form:option value="en">English</form:option><form:option value="hi">हिन्दी</form:option></form:select></div></div><p class="field-help">${ui['These preferences apply across the app on every device after signing in.']}</p></section>
 <div class="account-save"><button class="button button-primary" type="submit">${ui['Save changes']}</button></div>
 </form:form></div>
</main><%@ include file="../fragments/footer.jspf" %>
