<%@ page pageEncoding="UTF-8" %>
<header class="site-header">
 <div class="tricolour" aria-hidden="true"></div>
 <div class="utility-bar"><div class="container utility-inner">
  <div class="utility-left"><cp:icon name="landmark"/><span>${ui['Jaipur Citizen Services']}</span><span class="sep hide-sm" aria-hidden="true">|</span><span class="hide-sm">${ui['311-style grievance redressal']}</span></div>
  <div class="utility-right">
   <span class="helpline"><cp:icon name="siren"/><span class="helpline-label">${ui['Emergency']}</span> 112</span>
   <span class="util-divider" aria-hidden="true"></span>
   <span class="util-group" role="group" aria-label="${ui['Text size']}"><button type="button" class="util-btn" data-font-size="small" aria-label="${ui['Smaller text']}">A-</button><button type="button" class="util-btn" data-font-size="normal" aria-label="${ui['Normal text']}">A</button><button type="button" class="util-btn" data-font-size="large" aria-label="${ui['Larger text']}">A+</button></span>
   <form method="post" action="${ctx}/preferences"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="next" value="<c:out value='${currentPath}'/>"><button class="util-btn" name="theme" value="${theme eq 'dark' ? 'light' : 'dark'}" aria-label="${theme eq 'dark' ? ui['Switch to light theme'] : ui['Switch to dark theme']}" title="${theme eq 'dark' ? ui['Switch to light theme'] : ui['Switch to dark theme']}"><cp:icon name="${theme eq 'dark' ? 'sun' : 'moon'}"/></button></form>
   <form method="post" action="${ctx}/preferences" class="util-group" aria-label="${ui['Language']}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="next" value="<c:out value='${currentPath}'/>"><button class="util-btn" name="language" value="en" lang="en" aria-pressed="${language ne 'hi'}">English</button><button class="util-btn" name="language" value="hi" lang="hi" aria-pressed="${language eq 'hi'}">हिन्दी</button></form>
  </div>
 </div></div>
 <div class="masthead"><div class="container masthead-inner">
  <a class="brand" href="${ctx}/"><img class="brand-logo" src="${ctx}/assets/brand.svg" alt=""><span class="brand-text"><span class="brand-name">CivicPulse <span>${ui['Jaipur']}</span></span><span class="brand-tagline">${ui['Citizen grievance redressal portal']}</span></span></a>
  <div class="masthead-actions">
   <form method="get" action="${ctx}/track" class="track-mini" role="search"><label class="visually-hidden" for="track-mini-ref">${ui['Complaint reference number']}</label><input id="track-mini-ref" name="ref" maxlength="40" placeholder="${ui['Track: CP-2026-…']}" autocomplete="off"><button type="submit" aria-label="${ui['Track complaint']}"><cp:icon name="search"/></button></form>
   <c:choose><c:when test="${signedIn}">
    <a class="user-pill" href="${ctx}/account"><span class="avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(displayName,0,1))}"/></span><div><strong><c:out value="${displayName}"/></strong><small>${ui[roleLabel]}</small></div></a>
   </c:when><c:otherwise>
    <a class="btn btn-outline btn-sm" href="${ctx}/login" aria-label="${ui['Sign in']}"><cp:icon name="log-in"/><span class="btn-label">${ui['Sign in']}</span></a>
    <a class="btn btn-primary btn-sm" href="${ctx}/register" aria-label="${ui['Register']}"><cp:icon name="user-plus"/><span class="btn-label">${ui['Register']}</span></a>
   </c:otherwise></c:choose>
  </div>
 </div></div>
 <nav class="main-nav" aria-label="${ui['Main navigation']}"><div class="container nav-inner">
  <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="nav-list"><cp:icon name="menu"/>${ui['Menu']}</button>
  <ul class="nav-list" id="nav-list">
  <c:choose><c:when test="${signedIn}">
   <li><a class="nav-item ${pathOnly eq dashboardPath or (isCitizen and pathOnly eq '/feed') ? 'is-active' : ''}" href="${ctx}${dashboardPath}"><cp:icon name="${isCitizen ? 'map-pinned' : 'gauge'}"/>${isCitizen ? ui['Nearby feed'] : ui['Dashboard']}</a></li>
   <c:forEach items="${navigationLinks}" var="item">
    <c:set var="navIcon" value="list"/>
    <c:if test="${item.path eq '/citizen/reports/new'}"><c:set var="navIcon" value="plus"/></c:if>
    <c:if test="${item.path eq '/community'}"><c:set var="navIcon" value="map"/></c:if>
    <c:if test="${item.path eq '/insights'}"><c:set var="navIcon" value="chart-column"/></c:if>
    <c:if test="${item.path eq '/admin/officers'}"><c:set var="navIcon" value="users"/></c:if>
    <c:if test="${item.path eq '/officer/reports'}"><c:set var="navIcon" value="hard-hat"/></c:if>
    <li><a class="nav-item ${pathOnly eq item.path ? 'is-active' : ''}" href="<c:url value='${item.path}'/>"><cp:icon name="${navIcon}"/><c:out value="${ui[item.label]}"/></a></li>
   </c:forEach>
   <li><a class="nav-item ${pathOnly eq '/account' ? 'is-active' : ''}" href="${ctx}/account"><cp:icon name="circle-user"/>${ui['Account']}</a></li>
  </c:when><c:otherwise>
   <li><a class="nav-item ${pathOnly eq '/' ? 'is-active' : ''}" href="${ctx}/"><cp:icon name="house"/>${ui['Home']}</a></li>
   <li><a class="nav-item" href="${ctx}/#services"><cp:icon name="list-checks"/>${ui['Services']}</a></li>
   <li><a class="nav-item ${pathOnly eq '/track' ? 'is-active' : ''}" href="${ctx}/track"><cp:icon name="scan-search"/>${ui['Track complaint']}</a></li>
   <li><a class="nav-item" href="${ctx}/#how-it-works"><cp:icon name="route"/>${ui['How it works']}</a></li>
   <li><a class="nav-item" href="${ctx}/citizen/reports/new"><cp:icon name="plus"/>${ui['Report an issue']}</a></li>
  </c:otherwise></c:choose>
  </ul>
  <div class="nav-end"><c:if test="${signedIn}"><form method="post" action="${ctx}/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-on-dark btn-sm" type="submit"><cp:icon name="log-out"/>${ui['Sign out']}</button></form></c:if></div>
 </div></nav>
</header>
