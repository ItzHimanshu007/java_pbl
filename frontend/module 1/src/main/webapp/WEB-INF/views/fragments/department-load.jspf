<%@ page pageEncoding="UTF-8" %>
<div class="table-wrap"><table class="table"><thead><tr><th scope="col">${ui['Department']}</th><th scope="col">${ui['Open']}</th><th scope="col" class="num">${ui['Overdue']}</th><th scope="col" class="num">${ui['Closed']}</th></tr></thead><tbody>
 <c:forEach items="${departmentLoad}" var="d"><tr><th scope="row" class="text-sm"><c:out value="${ui[d.name]}"/></th><td><div class="dept-open"><svg class="bar dept-bar" aria-hidden="true"><title><c:out value="${ui[d.name]}"/>: ${d.open}</title><rect class="bar-track" width="100%" height="10" rx="4"/><rect class="bar-fill" width="${d.percent}%" height="10" rx="4"/></svg><strong>${d.open}</strong></div></td><td class="num"><c:choose><c:when test="${d.overdue gt 0}"><span class="chip badge-overdue"><cp:icon name="triangle-alert"/>${d.overdue}</span></c:when><c:otherwise><span class="muted">0</span></c:otherwise></c:choose></td><td class="num">${d.closed}</td></tr></c:forEach>
</tbody></table></div>
