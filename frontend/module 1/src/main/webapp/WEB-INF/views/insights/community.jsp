<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="${feed ? 'Nearby feed' : 'Community map'}"/>
<%@ include file="../fragments/head.jspf" %><%@ include file="../fragments/header.jspf" %>
<main id="main" class="container app-main">
 <div class="page-heading"><div><span class="eyebrow">${ui['YOUR NEIGHBOURHOOD']}</span><h1>${feed ? ui['Nearby feed'] : ui['Community map']}</h1><p>${ui['See what needs attention nearby and follow the work as it happens.']}</p></div><c:if test="${isCitizen}"><a class="button button-primary" href="<c:url value='/citizen/reports/new'/>">${ui['Report an issue']}</a></c:if></div>
 <c:if test="${param.supported != null}"><div class="notice notice-success" role="status">${ui['Your support has been recorded.']}</div></c:if>
 <form method="get" class="surface civic-form area-toolbar" data-address-widget data-area-widget data-lat-input="areaLatitude" data-lon-input="areaLongitude" data-has-area="${hasArea}">
 <div class="area-search"><label for="areaAddress">${ui['Explore an area']}</label><div class="address-search"><input id="areaAddress" data-address autocomplete="off" placeholder="${ui['Search a neighbourhood or landmark']}" aria-autocomplete="list" aria-controls="area-suggestions" aria-expanded="false"><div id="area-suggestions" class="address-suggestions" role="listbox" hidden></div></div></div>
 <input type="hidden" id="areaLatitude" name="latitude" value="${areaLatitude}"><input type="hidden" id="areaLongitude" name="longitude" value="${areaLongitude}">
 <div><label for="radius">${ui['Within']}</label><select id="radius" name="radius"><option value="2" ${areaRadius eq 2 ? 'selected' : ''}>${ui['2 km']}</option><option value="5" ${areaRadius eq 5 ? 'selected' : ''}>${ui['5 km']}</option><option value="10" ${areaRadius eq 10 ? 'selected' : ''}>${ui['10 km']}</option><option value="50" ${areaRadius eq 50 ? 'selected' : ''}>${ui['50 km']}</option></select></div>
 <button type="button" class="button button-outline" data-locate>${ui['Use my location']}</button><button type="submit" class="button button-primary">${ui['Update area']}</button>
 <p class="field-help" data-map-message role="status"><c:choose><c:when test="${hasArea}">${ui['Showing reports in your selected area.']}</c:when><c:otherwise>${ui['Choose an area to see nearby reports. Until then, recent community reports are shown.']}</c:otherwise></c:choose></p>
 </form>
 <div class="feed-layout"><section class="feed-list"><div class="feed-list-heading"><h2>${ui['Community issues']}</h2><span class="muted">${ui['Highest priority first']}</span></div>
 <c:if test="${empty reports}"><section class="surface empty-state"><h2>${ui['No reports in this area.']}</h2><p>${ui['Try a wider area or another location.']}</p></section></c:if>
 <c:forEach items="${reports}" var="r"><article id="report-${r.id}" class="surface community-card" data-community-report data-latitude="${r.latitude}" data-longitude="${r.longitude}" data-title="<c:out value='${r.title}'/>" data-reference="${r.reference}" data-status="${r.status}" data-priority="${r.priority}" data-count="${r.repeatCount}">
 <div class="section-bar"><span class="priority-chip priority-${r.priority}">${ui[r.priority]} ${ui['priority']}</span><span class="status status-${r.status}">${ui[r.status]}</span></div>
 <h2><a href="<c:url value='/community/${r.id}'/>"><c:out value="${r.title}"/></a></h2><p class="community-location">${ui[r.category]} · <c:out value="${r.address}"/></p><p class="issue-count"><strong>${r.repeatCount}</strong> ${ui['citizens reported this issue']}</p>
 <div class="work-progress"><div class="section-bar"><span>${ui['Work progress']}</span><strong>${r.progress}%</strong></div><progress max="100" value="${r.progress}" aria-label="${ui['Work progress']}">${r.progress}%</progress></div>
 <div class="community-card-end"><a class="text-link" href="<c:url value='/community/${r.id}'/>">${ui['View progress →']}</a><c:if test="${isCitizen and not r.mine and r.status ne 'CLOSED'}"><form method="post" action="<c:url value='/citizen/community/${r.id}/support'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="button button-small button-outline" type="submit" ${r.supported ? 'disabled' : ''}>${r.supported ? ui['Supported'] : ui['Support issue']} · ${r.supports}</button></form></c:if></div>
 </article></c:forEach></section>
 <aside class="feed-map-panel"><section class="surface map-surface"><div class="section-bar map-title"><h2>${ui['Area overview']}</h2><select data-priority-filter aria-label="${ui['Filter priority']}"><option value="all">${ui['All priorities']}</option><option value="high">${ui['High']}</option><option value="medium">${ui['Medium']}</option><option value="low">${ui['Low']}</option></select></div><div class="community-map" data-community-map data-latitude="${areaLatitude}" data-longitude="${areaLongitude}" data-radius="${areaRadius}" aria-label="${ui['Community reports map']}"></div>
 <div class="map-legend"><span><i class="legend-dot high"></i>${ui['High · 5+ reports']}</span><span><i class="legend-dot medium"></i>${ui['Medium · 2–4 reports']}</span><span><i class="legend-dot low"></i>${ui['Low · 1 report / closed']}</span></div><p class="field-help" data-community-message>${ui['Numbers on the map show citizens reporting the same issue. Select a pin to view its progress.']}</p></section>
 <section class="surface priority-help"><h2>${ui['How priority works']}</h2><p>${ui['Repeated reports linked to the same issue raise its priority. Each citizen counts once. Nearby reports are only suggestions until someone confirms they describe the same issue.']}</p><p class="field-help">${ui['Progress shows the current stage of work, not an estimate of time remaining.']}</p></section></aside></div>
</main><%@ include file="../fragments/footer.jspf" %>
