<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Community issue"/>
<%@ include file="../fragments/head.jspf" %><%@ include file="../fragments/header.jspf" %>
<main id="main" class="container app-main community-detail"><a class="text-link" href="<c:url value='/feed'/>">${ui['← Back to feed']}</a><div class="page-heading"><div><span class="eyebrow"><c:out value="${summary.reference}"/></span><h1><c:out value="${summary.title}"/></h1><p>${ui[summary.category]} · <c:out value="${summary.address}"/></p></div><span class="status status-${summary.status}">${ui[summary.status]}</span></div>
<div class="two-columns"><section class="surface"><h2>${ui['Current progress']}</h2><div class="work-progress"><div class="section-bar"><span>${ui[summary.status]}</span><strong>${summary.progress}%</strong></div><progress max="100" value="${summary.progress}" aria-label="${ui['Work progress']}"></progress></div><p class="muted">${ui['Progress shows the current stage of work, not an estimate of time remaining.']}</p><p><strong>${summary.repeatCount}</strong> ${ui['citizens reported this issue']}</p><span class="priority-chip priority-${summary.priority}">${ui[summary.priority]} ${ui['priority']}</span><c:if test="${summary.mine or isAdmin}"><p><a class="button button-outline" href="<c:url value='/reports/${summary.id}'/>">${ui['Open full report']}</a></p></c:if></section>
<section class="surface"><h2>${ui['Work timeline']}</h2><ol class="timeline"><c:forEach items="${updates}" var="update"><li><strong>${ui[update.action]}</strong><p>${ui[update.status]}</p><time datetime="${update.createdAt}"><c:out value="${update.createdAt}"/></time></li></c:forEach></ol></section></div>
</main><%@ include file="../fragments/footer.jspf" %>
