<%@ page pageEncoding="UTF-8" %>
<section class="kpi-row" aria-label="${ui['Report counts']}">
 <div class="kpi"><span class="kpi-icon tone-warn"><cp:icon name="clock"/></span><div><div class="kpi-value"><c:out value="${totals['REPORTED']}"/></div><div class="kpi-label">${ui['Awaiting review']}</div></div></div>
 <div class="kpi"><span class="kpi-icon tone-info"><cp:icon name="user-round"/></span><div><div class="kpi-value"><c:out value="${totals['ASSIGNED']}"/></div><div class="kpi-label">${ui['Assigned']}</div></div></div>
 <div class="kpi"><span class="kpi-icon tone-orange"><cp:icon name="hard-hat"/></span><div><div class="kpi-value"><c:out value="${totals['IN_PROGRESS']}"/></div><div class="kpi-label">${ui['In progress']}</div></div></div>
 <div class="kpi"><span class="kpi-icon tone-violet"><cp:icon name="check"/></span><div><div class="kpi-value"><c:out value="${totals['RESOLVED']}"/></div><div class="kpi-label">${ui['Ready to verify']}</div></div></div>
 <div class="kpi"><span class="kpi-icon tone-ok"><cp:icon name="badge-check"/></span><div><div class="kpi-value"><c:out value="${totals['CLOSED']}"/></div><div class="kpi-label">${ui['Verified closed']}</div></div></div>
 <div class="kpi"><span class="kpi-icon tone-bad"><cp:icon name="x"/></span><div><div class="kpi-value"><c:out value="${totals['REJECTED']}"/></div><div class="kpi-label">${ui['Rejected']}</div></div></div>
</section>
