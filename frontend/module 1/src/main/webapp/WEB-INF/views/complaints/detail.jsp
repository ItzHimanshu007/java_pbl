<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Report details"/>
<%@ include file="../fragments/head.jspf" %><%@ include file="../fragments/header.jspf" %>
<main id="main">
 <section class="page-head"><div class="container">
  <nav class="breadcrumbs" aria-label="${ui['Breadcrumb']}"><a href="${ctx}${dashboardPath}">${ui['Your workspace']}</a><cp:icon name="chevron-right"/><span><c:out value="${report.reference}"/></span></nav>
  <div class="page-head-row"><div><span class="eyebrow"><cp:icon name="cat-${report.categoryCode}"/>${ui[report.category]} · ${ui[report.department]}</span><h1 class="mt-1"><c:out value="${report.title}"/></h1>
   <div class="chips mt-2"><span class="chip status status-${report.status}">${ui[report.status]}</span><c:if test="${report.overdue}"><span class="chip badge-overdue"><cp:icon name="triangle-alert"/>${ui['Overdue']}</span></c:if><c:if test="${report.anonymous}"><span class="chip badge-anon"><cp:icon name="venetian-mask"/>${ui['Anonymous report']}</span></c:if><span class="chip"><span class="ref"><c:out value="${report.reference}"/></span></span></div></div>
   <div class="page-actions no-print"><button type="button" class="btn btn-on-dark btn-sm" data-copy="${report.reference}" data-copied="${ui['Reference copied']}"><cp:icon name="copy"/>${ui['Copy reference']}</button><button type="button" class="btn btn-light btn-sm" data-print><cp:icon name="printer"/>${ui['Print acknowledgement']}</button></div></div>
 </div></section>
 <div class="container page-body">
  <c:if test="${param.created != null}"><section class="ack" role="status"><span class="cat-tile cat-tile-lg"><cp:icon name="badge-check"/></span><div><h2>${ui['Complaint registered successfully']}</h2><p>${ui['Your reference number is']} <span class="ref"><c:out value="${report.reference}"/></span>. ${ui['It has been sent to']} ${ui[report.department]}. ${ui['Target resolution by']} <strong><time datetime="${report.dueAt}" data-date-only>${report.dueAt}</time></strong>.</p><p class="help mt-1">${ui['Anyone can check progress with this number on the Track complaint page.']}</p></div><a class="btn btn-outline no-print" href="${ctx}/track?ref=${report.reference}"><cp:icon name="scan-search"/>${ui['Public tracking page']}</a></section></c:if>
  <c:if test="${param.saved != null or param.updated != null or param.assigned != null or param.rejected != null}"><div class="alert alert-success mb" role="status"><cp:icon name="circle-check"/><p>${ui['The report has been updated.']}</p></div></c:if>

  <section class="card card-pad mt-2"><c:set var="stepIndex" value="${report.step}"/><c:set var="stepStatus" value="${report.status}"/><%@ include file="/WEB-INF/views/fragments/stepper.jspf" %></section>

  <div class="layout-main-side mt-3">
   <div class="stack">
    <section class="card"><div class="card-head"><h2 class="card-title"><cp:icon name="file-text"/>${ui['What was reported']}</h2></div>
     <div class="card-body"><p class="preserve-lines"><c:out value="${report.description}"/></p></div>
     <div class="card-body"><dl class="facts">
      <div><dt>${ui['Service']}</dt><dd><cp:icon name="cat-${report.categoryCode}"/>${ui[report.category]}</dd></div>
      <div><dt>${ui['Department']}</dt><dd><cp:icon name="building-2"/>${ui[report.department]}</dd></div>
      <div class="wide"><dt>${ui['Location']}</dt><dd><cp:icon name="map-pin"/><c:out value="${report.address}"/></dd></div>
      <div><dt>${ui['Zone']}</dt><dd><span class="chip badge-zone"><c:out value="${ui[zone]}"/></span></dd></div>
      <div><dt>${ui['Reported by']}</dt><dd><c:choose><c:when test="${report.anonymous}"><span class="chip badge-anon"><cp:icon name="venetian-mask"/>${ui['Anonymous citizen']}</span></c:when><c:when test="${isOwner}">${ui['You']}</c:when><c:otherwise>${ui['Registered citizen']}</c:otherwise></c:choose></dd></div>
      <div><dt>${ui['Submitted']}</dt><dd><time datetime="${report.createdAt}">${report.createdAt}</time></dd></div>
      <div><dt>${ui['Target resolution']}</dt><dd><span class="due ${report.overdue ? 'is-overdue' : ''}"><cp:icon name="timer"/><time datetime="${report.dueAt}" data-date-only>${report.dueAt}</time></span></dd></div>
      <div><dt>${ui['Assigned officer']}</dt><dd><cp:icon name="hard-hat"/><c:out value="${empty report.officerName ? ui['Awaiting assignment'] : report.officerName}"/></dd></div>
      <div><dt>${ui['Last update']}</dt><dd><time datetime="${report.updatedAt}" data-relative>${report.updatedAt}</time></dd></div>
     </dl></div>
    </section>

    <section class="card"><div class="card-head"><h2 class="card-title"><cp:icon name="image"/>${ui['Photo evidence']}</h2></div><div class="card-body">
     <c:if test="${demoMode and report.reference.startsWith('CP-DEMO') and not empty originals}"><p class="help">${ui['Sample photographs show different places; they illustrate the workflow. Your reports always use your uploaded photos.']} <a href="https://commons.wikimedia.org/wiki/File:Marked_Pothole.jpg">Prosthetic Head</a> · <a href="https://commons.wikimedia.org/wiki/File:2018-09-03_15_15_33_Recently_patched_potholes_along_Franklin_Farm_Road_in_the_Franklin_Farm_section_of_Oak_Hill,_Fairfax_County,_Virginia.jpg">Famartin</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></p></c:if>
     <c:choose>
      <c:when test="${not empty originals and not empty repairs}"><c:set var="beforeImage" value="${originals[0]}"/><c:set var="afterImage" value="${repairs[repairs.size()-1]}"/>
       <div class="comparison mt-2" data-comparison><div class="comparison-images"><img class="after-image" src="${ctx}/reports/images/${afterImage.id}" alt="${ui['Latest repair evidence']}"><div class="before-layer"><img src="${ctx}/reports/images/${beforeImage.id}" alt="${ui['Original reported issue']}"></div><span class="compare-before">${ui['Before']}</span><span class="compare-after">${ui['After']}</span></div><label class="help" for="comparison-slider">${ui['Move the slider to compare before and after']}</label><input id="comparison-slider" class="comparison-slider" type="range" min="0" max="100" value="50"></div>
      </c:when>
      <c:when test="${empty originals}"><div class="no-photo"><span class="cat-tile cat-tile-lg"><cp:icon name="cat-${report.categoryCode}"/></span><p>${ui['No photograph is attached to this sample report. Real complaints always include the citizen’s photo.']}</p></div></c:when>
      <c:otherwise><p class="muted">${ui['Repair evidence will appear here when the officer submits it.']}</p></c:otherwise>
     </c:choose>
     <c:if test="${not empty originals}"><div class="evidence-grid"><c:forEach items="${originals}" var="image"><figure><a href="${ctx}/reports/images/${image.id}"><img loading="lazy" src="${ctx}/reports/images/${image.id}" alt="${ui['Original issue photograph']}"></a><figcaption>${ui['Original report']}</figcaption></figure></c:forEach><c:forEach items="${repairs}" var="image" varStatus="n"><figure><a href="${ctx}/reports/images/${image.id}"><img loading="lazy" src="${ctx}/reports/images/${image.id}" alt="${ui['Repair evidence']} ${n.count}"></a><figcaption>${ui['Repair evidence']} ${n.count}</figcaption></figure></c:forEach></div></c:if>
    </div></section>

    <section class="card"><div class="card-head"><h2 class="card-title"><cp:icon name="clock"/>${ui['Report timeline']}</h2></div><div class="card-body"><ol class="timeline">
     <c:forEach items="${events}" var="event"><li class="tl-item"><span class="tl-dot"><cp:icon name="check"/></span><div class="tl-head"><strong>${ui[event.labelKey]}</strong><span class="chip status status-${event.toStatus}">${ui[event.toStatus]}</span></div><c:if test="${not empty event.note}"><p class="preserve-lines"><c:out value="${event.note}"/></p></c:if><small><c:out value="${ui[event.actor]}"/> · <time datetime="${event.createdAt}">${event.createdAt}</time></small></li></c:forEach>
    </ol></div></section>
   </div>

   <aside class="stack">
    <c:if test="${canAssign}"><section class="card action-card card-accent"><div class="card-head"><h2 class="card-title"><cp:icon name="landmark"/>${ui['Assign the right team']}</h2></div><div class="card-body"><c:choose><c:when test="${empty officers}"><p>${ui['Create an enabled officer account before assigning this report.']}</p><a class="btn btn-outline mt-2" href="${ctx}/admin/officers">${ui['Manage officers']}</a></c:when><c:otherwise>
     <form method="post" class="form" action="${ctx}/admin/reports/${report.id}/assign"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="departmentId">${ui['Department']}</label><select id="departmentId" name="departmentId" required><c:forEach items="${departments}" var="d"><option value="${d.id}" ${d.id eq report.departmentId ? 'selected' : ''}><c:out value="${ui[d.name]}"/></option></c:forEach></select></div><div class="field"><label for="officerId">${ui['Officer']}</label><select id="officerId" name="officerId" required><option value="">${ui['Choose an officer']}</option><c:forEach items="${officers}" var="o"><option value="${o.id}" data-department="${o.departmentId}"><c:out value="${o.name}"/> — <c:out value="${ui[o.department]}"/></option></c:forEach></select></div><div class="field"><label for="assignment-note">${ui['Assignment note']}</label><textarea id="assignment-note" name="note" minlength="5" maxlength="1000" required rows="3"></textarea></div><button class="btn btn-primary btn-block" type="submit"><cp:icon name="send"/>${ui['Assign report']}</button></form>
    </c:otherwise></c:choose></div></section></c:if>
    <c:if test="${canReject}"><section class="card action-card card-pad"><details class="disclosure danger"><summary><cp:icon name="x"/>${ui['Reject this report']}</summary><form method="post" class="form" action="${ctx}/admin/reports/${report.id}/reject"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="rejection-note">${ui['Reason for the citizen']}</label><textarea id="rejection-note" name="note" minlength="5" maxlength="1000" required rows="3"></textarea></div><button class="btn btn-danger btn-block" type="submit">${ui['Reject with reason']}</button></form></details></section></c:if>
    <c:if test="${canStart}"><section class="card action-card card-accent"><div class="card-head"><h2 class="card-title"><cp:icon name="hard-hat"/>${ui['Begin the repair']}</h2></div><div class="card-body"><form method="post" class="form" action="${ctx}/officer/reports/${report.id}/start"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="start-note">${ui['Work plan']}</label><textarea name="note" id="start-note" required minlength="5" maxlength="1000" rows="3"></textarea></div><button class="btn btn-primary btn-block" type="submit"><cp:icon name="arrow-right"/>${ui['Start work']}</button></form></div></section></c:if>
    <c:if test="${canProgress}"><section class="card action-card"><div class="card-head"><h2 class="card-title"><cp:icon name="send"/>${ui['Keep the citizen updated']}</h2></div><div class="card-body"><form method="post" class="form" action="${ctx}/officer/reports/${report.id}/progress"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="progress-note">${ui['Progress update']}</label><textarea name="note" id="progress-note" required minlength="5" maxlength="1000" rows="3"></textarea></div><button class="btn btn-outline btn-block" type="submit">${ui['Post update']}</button></form></div></section>
     <section class="card action-card card-accent"><div class="card-head"><h2 class="card-title"><cp:icon name="check"/>${ui['Submit the repair']}</h2></div><div class="card-body"><form method="post" class="form" enctype="multipart/form-data" action="${ctx}/officer/reports/${report.id}/resolve"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="repair-note">${ui['What was repaired?']}</label><textarea name="note" id="repair-note" required minlength="5" maxlength="1000" rows="3"></textarea></div><div class="field" data-photo-widget><label for="repair-photo">${ui['After photograph']}</label><input name="photo" type="file" id="repair-photo" required accept="image/png,image/jpeg" data-photo-input><div class="photo-actions"><button type="button" class="btn btn-outline btn-sm" data-camera><cp:icon name="camera"/>${ui['Take a photograph']}</button><button type="button" class="btn btn-ghost btn-sm" data-remove-photo hidden>${ui['Remove photo']}</button></div><input type="file" accept="image/*" capture="environment" data-native-camera hidden><figure class="photo-preview" hidden><img data-photo-preview alt="${ui['Selected repair photograph']}"><figcaption data-photo-caption></figcaption></figure><p class="help" data-photo-message role="status">${ui['PNG or JPEG, up to 5 MB.']}</p></div><button class="btn btn-primary btn-block" type="submit"><cp:icon name="send"/>${ui['Send for verification']}</button></form></div></section></c:if>
    <c:if test="${canVerify}"><section class="card action-card card-accent"><div class="card-head"><h2 class="card-title"><cp:icon name="badge-check"/>${ui['Is the issue fixed?']}</h2></div><div class="card-body"><p class="muted">${ui['Review the repair evidence and the actual location before confirming.']}</p><form method="post" class="mt-2" action="${ctx}/citizen/reports/${report.id}/confirm"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary btn-block" type="submit"><cp:icon name="check"/>${ui['Confirm and close']}</button></form></div>
     <div class="card-foot"><details class="disclosure"><summary><cp:icon name="triangle-alert"/>${ui['The issue still needs work']}</summary><form method="post" class="form" action="${ctx}/citizen/reports/${report.id}/reopen"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="field"><label for="reopen-note">${ui['What still needs attention?']}</label><textarea name="note" id="reopen-note" required minlength="5" maxlength="1000" rows="3"></textarea></div><button class="btn btn-outline btn-block" type="submit">${ui['Reopen report']}</button></form></details></div></section></c:if>

    <section class="card"><div class="card-head"><h2 class="card-title"><cp:icon name="map-pin"/>${ui['Location']}</h2><span class="chip badge-zone"><c:out value="${ui[zone]}"/></span></div><div class="card-body"><div class="map map-sm" data-mini-map data-latitude="${report.latitude}" data-longitude="${report.longitude}" data-code="${report.categoryCode}" data-status="${report.status}" aria-label="${ui['Report location map']}"></div><p class="help mt-1"><c:out value="${report.address}"/></p></div></section>
    <c:if test="${report.anonymous}"><div class="anon-note"><cp:icon name="shield-check"/><div><strong>${ui['Reporter identity protected']}</strong>${ui['This complaint was filed anonymously. Only a one-way encrypted fingerprint of the reporter is stored; staff cannot see who reported it.']}</div></div></c:if>
    <c:if test="${canDelete}"><section class="card card-pad no-print"><details class="disclosure danger"><summary><cp:icon name="x"/>${ui['Delete report']}</summary><p class="help">${ui['Move this report to Deleted reports. You can restore it later.']}</p><form method="post" class="mt-2" action="${ctx}/citizen/reports/${report.id}/delete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-danger btn-sm" type="submit">${ui['Delete report']}</button></form></details></section></c:if>
   </aside>
  </div>
 </div>
</main>
<%@ include file="../fragments/footer.jspf" %>
