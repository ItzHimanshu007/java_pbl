<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Report details"/>
<%@ include file="../fragments/head.jspf" %>
<%@ include file="../fragments/header.jspf" %>
<main id="main" class="container app-main">


<a class="text-link" href="<c:url value='${dashboardPath}'/>">${ui['← Your workspace']}</a>
<div class="page-heading"><div><span class="eyebrow"><c:out value="${report.reference}"/></span><h1><c:out value="${report.title}"/></h1><p>${ui[report.category]} · ${ui[report.department]}</p></div><span class="status status-${report.status}">${ui[report.status]}</span></div>
<c:if test="${param.created != null}"><div class="notice notice-success" role="status">${ui['Your report has been submitted for review. Keep its reference to track progress.']}</div></c:if>
<c:if test="${param.saved != null or param.updated != null or param.assigned != null or param.rejected != null}"><div class="notice notice-success" role="status">${ui['The report has been updated.']}</div></c:if>
<div class="detail-grid"><div><section class="surface"><h2>${ui['What was reported']}</h2><p class="preserve-lines"><c:out value="${report.description}"/></p><dl class="detail-facts"><dt>${ui['Location']}</dt><dd><c:out value="${report.address}"/></dd><dt>${ui['Assigned officer']}</dt><dd><c:out value="${empty report.officerName ? ui['Awaiting assignment'] : report.officerName}"/></dd><dt>${ui['Submitted']}</dt><dd><time datetime="${report.createdAt}"><c:out value="${report.createdAt}"/></time></dd></dl><c:if test="${canDelete}"><details class="delete-control"><summary>${ui['Delete report']}</summary><p>${ui['Move this report to Deleted reports. You can restore it later.']}</p><form method="post" action="<c:url value='/citizen/reports/${report.id}/delete'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="button button-small button-danger" type="submit">${ui['Delete report']}</button></form></details></c:if></section>
<section class="surface"><h2>${ui['Evidence of the change']}</h2><c:if test="${demoMode and report.reference.startsWith('CP-DEMO')}"><p class="field-help">${ui['Sample photographs show different places; they illustrate the workflow. Your reports always use your uploaded photos.']} <a href="https://commons.wikimedia.org/wiki/File:Marked_Pothole.jpg">Prosthetic Head</a> · <a href="https://commons.wikimedia.org/wiki/File:2018-09-03_15_15_33_Recently_patched_potholes_along_Franklin_Farm_Road_in_the_Franklin_Farm_section_of_Oak_Hill,_Fairfax_County,_Virginia.jpg">Famartin</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></p></c:if><c:choose><c:when test="${not empty originals and not empty repairs}"><c:set var="beforeImage" value="${originals[0]}"/><c:set var="afterImage" value="${repairs[repairs.size()-1]}"/>
<div class="comparison" data-comparison><div class="comparison-images"><img class="after-image" src="<c:url value='/reports/images/${afterImage.id}'/>" alt="${ui['Latest repair evidence']}"><div class="before-layer"><img src="<c:url value='/reports/images/${beforeImage.id}'/>" alt="${ui['Original reported issue']}"></div><span class="compare-before">${ui['Before']}</span><span class="compare-after">${ui['After']}</span></div><label for="comparison-slider">${ui['Move the slider to compare before and after']}</label><input id="comparison-slider" class="comparison-slider" type="range" min="0" max="100" value="50"></div>
</c:when><c:otherwise><p class="muted">${ui['Repair evidence will appear here when the officer submits it.']}</p></c:otherwise></c:choose>
<div class="evidence-grid"><c:forEach items="${originals}" var="image"><figure><a href="<c:url value='/reports/images/${image.id}'/>"><img loading="lazy" src="<c:url value='/reports/images/${image.id}'/>" alt="${ui['Original issue photograph']}"></a><figcaption>${ui['Original report · Open full image']}</figcaption></figure></c:forEach><c:forEach items="${repairs}" var="image" varStatus="n"><figure><a href="<c:url value='/reports/images/${image.id}'/>"><img loading="lazy" src="<c:url value='/reports/images/${image.id}'/>" alt="Repair evidence ${n.count}"></a><figcaption>Repair evidence ${n.count} · Open full image</figcaption></figure></c:forEach></div></section>
<section class="surface"><h2>${ui['Report timeline']}</h2><ol class="timeline"><c:forEach items="${events}" var="event"><li><div class="timeline-heading"><strong>${ui[event.action]}</strong><span class="status">${ui[event.toStatus]}</span></div><p class="preserve-lines"><c:out value="${event.note}"/></p><small><c:out value="${event.actor}"/> · <time datetime="${event.createdAt}"><c:out value="${event.createdAt}"/></time></small></li></c:forEach></ol></section></div>
<aside><c:if test="${canAssign}"><section class="surface action-card"><span class="eyebrow">${ui['ADMINISTRATOR REVIEW']}</span><h2>${ui['Assign the right team']}</h2><c:choose><c:when test="${empty officers}"><p>${ui['Create an enabled officer account before assigning this report.']}</p><a class="button button-outline" href="<c:url value='/admin/officers'/>">${ui['Manage officers']}</a></c:when><c:otherwise>
<form method="post" class="civic-form" action="<c:url value='/admin/reports/${report.id}/assign'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="departmentId">${ui['Department']}</label><select id="departmentId" name="departmentId" required><c:forEach items="${departments}" var="d"><option value="${d.id}" ${d.id eq report.departmentId ? 'selected' : ''}><c:out value="${ui[d.name]}"/></option></c:forEach></select><label for="officerId">${ui['Officer']}</label><select id="officerId" name="officerId" required><option value="">${ui['Choose an officer']}</option><c:forEach items="${officers}" var="o"><option value="${o.id}" data-department="${o.departmentId}"><c:out value="${o.name}"/> — <c:out value="${ui[o.department]}"/></option></c:forEach></select><label for="assignment-note">${ui['Assignment note']}</label><textarea id="assignment-note" name="note" minlength="5" maxlength="1000" required rows="3"></textarea><button class="button button-primary button-full" type="submit">${ui['Assign report →']}</button></form>
</c:otherwise></c:choose></section></c:if>
<c:if test="${canReject}"><section class="surface action-card"><details><summary>${ui['Reject this report']}</summary><form method="post" class="civic-form" action="<c:url value='/admin/reports/${report.id}/reject'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="rejection-note">${ui['Reason for the citizen']}</label><textarea id="rejection-note" name="note" minlength="5" maxlength="1000" required rows="3"></textarea><button class="button button-outline button-full" type="submit">${ui['Reject with reason']}</button></form></details></section></c:if>
<c:if test="${canStart}"><section class="surface action-card"><span class="eyebrow">${ui['YOUR ASSIGNED WORK']}</span><h2>${ui['Begin the repair']}</h2><form method="post" class="civic-form" action="<c:url value='/officer/reports/${report.id}/start'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="start-note">${ui['Work plan']}</label><textarea name="note" id="start-note" required minlength="5" maxlength="1000" rows="3"></textarea><button class="button button-primary button-full" type="submit">${ui['Start work →']}</button></form></section></c:if>
<c:if test="${canProgress}"><section class="surface action-card"><h2>${ui['Keep the citizen updated']}</h2><form method="post" class="civic-form" action="<c:url value='/officer/reports/${report.id}/progress'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="progress-note">${ui['Progress update']}</label><textarea name="note" id="progress-note" required minlength="5" maxlength="1000" rows="3"></textarea><button class="button button-outline button-full" type="submit">${ui['Post update']}</button></form></section>
<section class="surface action-card"><h2>${ui['Submit the repair']}</h2><form method="post" class="civic-form" enctype="multipart/form-data" action="<c:url value='/officer/reports/${report.id}/resolve'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="repair-note">${ui['What was repaired?']}</label><textarea name="note" id="repair-note" required minlength="5" maxlength="1000" rows="3"></textarea><div data-photo-widget><label for="repair-photo">${ui['After photograph']}</label><input name="photo" type="file" id="repair-photo" required accept="image/png,image/jpeg" data-photo-input><div class="photo-actions"><button type="button" class="button button-small button-outline" data-camera>${ui['Take a photograph']}</button><button type="button" class="button button-small button-outline" data-remove-photo hidden>${ui['Remove photo']}</button></div><input type="file" accept="image/*" capture="environment" data-native-camera hidden><figure class="photo-preview" hidden><img data-photo-preview alt="${ui['Selected repair photograph']}"><figcaption data-photo-caption></figcaption></figure><p class="field-help" data-photo-message role="status"></p></div><p class="field-help">${ui['PNG or JPEG, up to 5 MB.']}</p><button class="button button-primary button-full" type="submit">${ui['Send for verification →']}</button></form></section></c:if>
<c:if test="${canVerify}"><section class="surface action-card"><span class="eyebrow">${ui['YOUR FINAL SAY']}</span><h2>${ui['Is the issue fixed?']}</h2><p>${ui['Review the repair evidence and the actual location before confirming.']}</p><form method="post" action="<c:url value='/citizen/reports/${report.id}/confirm'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="button button-primary button-full" type="submit">${ui['Confirm and close ✓']}</button></form></section><section class="surface action-card"><details><summary>${ui['The issue still needs work']}</summary><form method="post" class="civic-form" action="<c:url value='/citizen/reports/${report.id}/reopen'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="reopen-note">${ui['What still needs attention?']}</label><textarea name="note" id="reopen-note" required minlength="5" maxlength="1000" rows="3"></textarea><button class="button button-outline button-full" type="submit">${ui['Reopen report']}</button></form></details></section></c:if>
<section class="surface action-card"><h2>${ui['A clear path']}</h2><p>${ui['Reported → Assigned → In progress → Ready for verification → Closed']}</p><p>${ui['Each action is saved to the report timeline.']}</p></section></aside></div>

</main>
<%@ include file="../fragments/footer.jspf" %>
