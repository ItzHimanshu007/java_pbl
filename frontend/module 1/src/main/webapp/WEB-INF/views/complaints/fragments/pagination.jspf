<%@ page pageEncoding="UTF-8" %>
<nav class="pagination-bar" aria-label="${ui['Report pages']}"><span><c:out value="${total}"/> ${ui['reports']} · ${ui['Page']} ${page + 1}</span>
 <div><c:if test="${page > 0}"><c:url var="previous" value=""><c:param name="page" value="${page - 1}"/><c:param name="trash" value="${trash}"/><c:param name="status" value="${statusFilter}"/><c:param name="q" value="${searchQuery}"/></c:url><a class="button button-small button-outline" href="<c:out value='${previous}'/>">${ui['Previous']}</a></c:if>
 <c:if test="${(page + 1) * 10 < total}"><c:url var="next" value=""><c:param name="page" value="${page + 1}"/><c:param name="trash" value="${trash}"/><c:param name="status" value="${statusFilter}"/><c:param name="q" value="${searchQuery}"/></c:url><a class="button button-small button-outline" href="<c:out value='${next}'/>">${ui['Next']}</a></c:if></div>
</nav>
