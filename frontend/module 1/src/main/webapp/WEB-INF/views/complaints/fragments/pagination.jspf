<%@ page pageEncoding="UTF-8" %>
<nav class="pager" aria-label="${ui['Report pages']}"><span><c:out value="${total}"/> ${ui['reports']} · ${ui['Page']} ${page + 1}</span>
 <div><c:if test="${page > 0}"><c:url var="previous" value=""><c:param name="page" value="${page - 1}"/><c:param name="trash" value="${trash}"/><c:param name="status" value="${statusFilter}"/><c:param name="q" value="${searchQuery}"/><c:if test="${not empty categoryFilter}"><c:param name="category" value="${categoryFilter}"/></c:if></c:url><a class="btn btn-outline btn-sm" href="<c:out value='${previous}'/>"><cp:icon name="arrow-left"/>${ui['Previous']}</a></c:if>
 <c:if test="${(page + 1) * 10 < total}"><c:url var="next" value=""><c:param name="page" value="${page + 1}"/><c:param name="trash" value="${trash}"/><c:param name="status" value="${statusFilter}"/><c:param name="q" value="${searchQuery}"/><c:if test="${not empty categoryFilter}"><c:param name="category" value="${categoryFilter}"/></c:if></c:url><a class="btn btn-outline btn-sm" href="<c:out value='${next}'/>">${ui['Next']}<cp:icon name="arrow-right"/></a></c:if></div>
</nav>
