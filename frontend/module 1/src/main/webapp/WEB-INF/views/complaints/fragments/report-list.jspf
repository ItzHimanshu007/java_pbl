<%@ page pageEncoding="UTF-8" %>
<div class="report-list">
 <c:if test="${empty reports}"><div class="empty-state"><h3>${ui['No reports in this view.']}</h3><p>${ui['New reports and updates will appear here.']}</p></div></c:if>
 <c:forEach items="${reports}" var="row"><article class="report-row">
  <div><span class="reference"><c:out value="${row.reference}"/></span><h3><a href="<c:url value='/reports/${row.id}'/>"><c:out value="${row.title}"/></a></h3><p>${ui[row.category]} · <c:out value="${row.address}"/></p><time datetime="${row.createdAt}"><c:out value="${row.createdAt}"/></time></div>
  <div class="report-row-end"><span class="status status-${row.status}">${ui[row.status]}</span><a class="text-link" href="<c:url value='/reports/${row.id}'/>">${ui['View report →']}</a></div>
 </article></c:forEach>
</div>
