<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Officer accounts"/>
<%@ include file="../fragments/head.jspf" %><%@ include file="../fragments/header.jspf" %>
<main id="main">
 <section class="page-head"><div class="container"><nav class="breadcrumbs" aria-label="${ui['Breadcrumb']}"><a href="${ctx}/admin/dashboard">${ui['Dashboard']}</a><cp:icon name="chevron-right"/><span>${ui['Officers']}</span></nav><div class="page-head-row"><div><span class="eyebrow">${ui['The people behind the progress']}</span><h1>${ui['Officer accounts']}</h1><p>${ui['Each officer belongs to a department and sees only their assigned reports.']}</p></div></div></div></section>
 <div class="container page-body stack">
  <c:if test="${param.created != null}"><div class="alert alert-success" role="status"><cp:icon name="circle-check"/><p>${ui['Officer account created. Share the credentials with the officer directly.']}</p></div></c:if><c:if test="${param.updated != null}"><div class="alert alert-success" role="status"><cp:icon name="circle-check"/><p>${ui['Officer access updated.']}</p></div></c:if>
  <div class="layout-main-side">
   <section class="card"><div class="card-head"><h2 class="card-title"><cp:icon name="users"/>${ui['Your officers']}</h2><span class="chip">${officers.size()}</span></div>
    <c:choose><c:when test="${empty officers}"><div class="empty"><cp:icon name="users"/><h3>${ui['No officers yet.']}</h3><p>${ui['Add your first officer using the form.']}</p></div></c:when><c:otherwise>
    <div class="table-wrap"><table class="table"><thead><tr><th scope="col">${ui['Officer']}</th><th scope="col">${ui['Department']}</th><th scope="col">${ui['Access']}</th><th scope="col"><span class="visually-hidden">${ui['Action']}</span></th></tr></thead><tbody>
     <c:forEach items="${officers}" var="o"><tr><td><div class="row"><span class="avatar" aria-hidden="true"><c:out value="${fn:substring(o.name,0,1)}"/></span><div><strong><c:out value="${o.name}"/></strong><div class="muted text-xs"><c:out value="${o.email}"/></div></div></div></td><td class="text-sm"><c:out value="${ui[o.department]}"/></td><td><span class="chip ${o.enabled ? 'status status-CLOSED' : 'status status-REJECTED'}">${o.enabled ? ui['Enabled'] : ui['Disabled']}</span></td><td><form method="post" action="${ctx}/admin/officers/${o.id}/access"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="enabled" value="${not o.enabled}"><button type="submit" class="btn btn-outline btn-sm">${o.enabled ? ui['Disable'] : ui['Enable']}</button></form></td></tr></c:forEach>
    </tbody></table></div></c:otherwise></c:choose>
    <div class="card-foot help">${ui['An officer with assigned, ongoing or unverified work cannot be disabled until the work is reassigned or completed.']}</div></section>
   <section class="card card-accent"><div class="card-head"><h2 class="card-title"><cp:icon name="user-plus"/>${ui['Add an officer']}</h2></div><div class="card-body"><form:form method="post" action="${ctx}/admin/officers" modelAttribute="officerForm" cssClass="form"><c:if test="${not empty requestScope['org.springframework.validation.BindingResult.officerForm'].allErrors}"><div class="alert alert-error" role="alert"><cp:icon name="circle-alert"/><div><c:forEach items="${requestScope['org.springframework.validation.BindingResult.officerForm'].allErrors}" var="error"><p><c:out value="${ui[error.defaultMessage]}"/></p></c:forEach></div></div></c:if>
    <div class="field"><label for="displayName">${ui['Full name']}</label><form:input path="displayName" id="displayName" required="required" minlength="2" maxlength="80"/></div><div class="field"><label for="email">${ui['Email address']}</label><form:input path="email" id="email" type="email" required="required" maxlength="190"/></div><div class="field"><label for="officer-password">${ui['Password']}</label><input id="officer-password" name="password" type="password" required minlength="10" maxlength="72" autocomplete="new-password"></div><div class="field"><label for="departmentId">${ui['Department']}</label><form:select path="departmentId" id="departmentId" required="required"><form:option value="">${ui['Choose a department']}</form:option><c:forEach items="${departments}" var="d"><form:option value="${d.id}">${ui[d.name]}</form:option></c:forEach></form:select></div><button class="btn btn-primary btn-block" type="submit"><cp:icon name="user-plus"/>${ui['Create officer']}</button></form:form></div></section>
  </div>
 </div>
</main><%@ include file="../fragments/footer.jspf" %>
