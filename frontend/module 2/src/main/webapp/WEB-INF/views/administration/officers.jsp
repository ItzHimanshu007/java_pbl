<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Officer accounts"/>
<%@ include file="../fragments/head.jspf" %>
<%@ include file="../fragments/header.jspf" %>
<main id="main" class="container app-main">


<div class="page-heading"><div><span class="eyebrow">${ui['THE PEOPLE BEHIND THE PROGRESS']}</span><h1>${ui['Officer accounts']}</h1><p>${ui['Each officer belongs to a department and sees only their assigned reports.']}</p></div></div>
<c:if test="${param.created != null}"><div class="notice notice-success" role="status">${ui['Officer account created. Share the credentials with the officer directly.']}</div></c:if><c:if test="${param.updated != null}"><div class="notice notice-success" role="status">${ui['Officer access updated.']}</div></c:if>
<div class="detail-grid"><section class="surface"><h2>${ui['Your officers']}</h2><div class="officer-list"><c:if test="${empty officers}"><p class="muted">${ui['Add your first officer using the form.']}</p></c:if><c:forEach items="${officers}" var="o"><article class="officer-row"><div><h3><c:out value="${o.name}"/></h3><p><c:out value="${o.email}"/></p><small><c:out value="${ui[o.department]}"/> · ${o.enabled ? ui['Enabled'] : ui['Disabled']}</small></div><form method="post" action="<c:url value='/admin/officers/${o.id}/access'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="enabled" value="${not o.enabled}"><button type="submit" class="button button-small button-outline">${o.enabled ? ui['Disable'] : ui['Enable']}</button></form></article></c:forEach></div><p class="field-help">${ui['An officer with assigned, ongoing or unverified work cannot be disabled until the work is reassigned or completed.']}</p></section>
<section class="surface action-card"><h2>${ui['Add an officer']}</h2><form:form method="post" action="${pageContext.request.contextPath}/admin/officers" modelAttribute="officerForm" cssClass="civic-form"><c:if test="${not empty requestScope['org.springframework.validation.BindingResult.officerForm'].allErrors}"><div class="notice notice-error" role="alert"><c:forEach items="${requestScope['org.springframework.validation.BindingResult.officerForm'].allErrors}" var="error"><p><c:out value="${ui[error.defaultMessage]}"/></p></c:forEach></div></c:if><label for="displayName">${ui['Full name']}</label><form:input path="displayName" id="displayName" required="required" minlength="2" maxlength="80"/><label for="email">${ui['Email address']}</label><form:input path="email" id="email" type="email" required="required" maxlength="190"/><label for="officer-password">${ui['Password']}</label><input id="officer-password" name="password" type="password" required minlength="10" maxlength="72" autocomplete="new-password"><label for="departmentId">${ui['Department']}</label><form:select path="departmentId" id="departmentId" required="required"><form:option value="">${ui['Choose a department']}</form:option><c:forEach items="${departments}" var="d"><form:option value="${d.id}">${ui[d.name]}</form:option></c:forEach></form:select><button class="button button-primary button-full" type="submit">${ui['Create officer →']}</button></form:form></section></div>

</main>
<%@ include file="../fragments/footer.jspf" %>
